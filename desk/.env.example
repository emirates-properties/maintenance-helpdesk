# EPFM Application URL Configuration
# =====================================
# This file shows examples of how to configure the EPFM app URL
# for different environments.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (for default config)
# 2. Or create .env.local (for personal overrides, not tracked in git)
# 3. Restart the dev server: npm run dev

# =====================================
# DEVELOPMENT (Local)
# =====================================
# Default: EPFM Vue app running on port 8081
VITE_EPFM_URL=http://localhost:8081

# If your EPFM runs on a different port:
# VITE_EPFM_URL=http://localhost:8082
# VITE_EPFM_URL=http://localhost:9090

# =====================================
# PRODUCTION Options
# =====================================
# Option 1: Same domain (both apps behind reverse proxy)
# Leave empty or don't set - uses relative path
# VITE_EPFM_URL=

# Option 2: Different subdomain
# VITE_EPFM_URL=https://epfm.yourdomain.com

# Option 3: Different domain
# VITE_EPFM_URL=https://epfm-system.example.com

# Option 4: Different port on same domain
# VITE_EPFM_URL=https://yourdomain.com:9090

# =====================================
# NOTES:
# =====================================
# - All VITE_* variables must start with VITE_ to be exposed to the app
# - Changes require restarting the dev server
# - In production, set via deployment environment or .env.production file
# - .env.local takes precedence over .env (use for personal settings)
